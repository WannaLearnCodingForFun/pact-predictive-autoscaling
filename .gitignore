# macOS
.DS_Store

# Downloaded traces and experiment outputs
data/raw/
results/
figures/

# ...except the measured outputs and plots the paper is built from.
# These are the paper's evidence base: every table and figure in
# PACT_paper.docx is generated from them, so they are version-controlled.
!results/
!results/*.csv
!results/manifest.json
!figures/
!figures/fig_*.png

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
